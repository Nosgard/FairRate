# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed

# Leave empty while USE_FAKE_LLM=true
ANTHROPIC_API_KEY=

# Model used for generation
MODEL=ollama

OLLAMA_MODEL=qwen2.5:14b

# Which system prompt version to load from app/core/prompts/
PROMPT_VERSION=v3

# Generator set to fake = no API calls, no cost
GENERATOR=fake
# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed

# Leave empty while USE_FAKE_LLM=true
ANTHROPIC_API_KEY=

# Model used for generation
MODEL=claude-haiku-4-5-20251001

# Which system prompt version to load from app/core/prompts/
PROMPT_VERSION=v1

# true = no API calls, no cost. Set to false once you have a key
USE_FAKE_LLM=true